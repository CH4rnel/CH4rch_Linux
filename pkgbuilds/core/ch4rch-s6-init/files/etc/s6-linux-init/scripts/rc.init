#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs dev /dev
mount -t tmpfs tmpfs /run

mkdir -p /run/service

hostname -F /etc/hostname

/usr/lib/ch4rch/compile-services

s6-rc-init \
    -c /etc/s6-rc/compiled \
    /run/service

s6-rc -u change base

exec s6-svscan /run/service
