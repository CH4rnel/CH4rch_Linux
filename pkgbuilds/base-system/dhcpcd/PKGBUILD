# Maintainer: CH4rch Linux Team
pkgname=dhcpcd
pkgver=10.0.5
pkgrel=1
pkgdesc="RFC2131 compliant DHCP client daemon"
arch=('x86_64')
url="https://roy.marples.ca/projects/dhcpcd/"
license=('BSD')
depends=('glibc' 'udev')
source=("https://roy.marples.ca/downloads/$pkgname-$pkgver.tar.xz")
sha256sums=('SKIP') # TODO: Replace with actual SHA256 for reproducibility

build() {
    cd "$srcdir/$pkgname-$pkgver"
    ./configure --prefix=/usr --sysconfdir=/etc --libexecdir=/usr/lib/dhcpcd
    make
}

package() {
    cd "$srcdir/$pkgname-$pkgver"
    make DESTDIR="$pkgdir" install
}